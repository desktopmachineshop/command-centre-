{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": {},
    "test": { "env": ["TEST_DATABASE_URL"] },
    "@cc/server#test": { "dependsOn": ["@cc/web#build"], "env": ["TEST_DATABASE_URL", "PW_CHROMIUM"] },
    "@cc/worker#test": { "dependsOn": ["@cc/server#test"], "env": ["TEST_DATABASE_URL"] },
    "dev": { "cache": false, "persistent": true }
  }
}
