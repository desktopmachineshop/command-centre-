{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Centre",
  "version": "0.1.0",
  "identifier": "com.desktopmachineshop.commandcentre",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cc-worker"
    ],
    "shortDescription": "Command Centre desktop app and worker node",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOTQ3MTIxMkJGMTNCNDcKUldSSE8vRXJJWEdVNHhVcmJValBUN0JETjMvbUhHZXBqZjNhY3lLdkdaaTVXa2o3MVk5bFNMMXYK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
