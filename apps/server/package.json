{
  "name": "@cc/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "user:create": "tsx --env-file-if-exists=../../.env src/cli.ts create",
    "user:reset-password": "tsx --env-file-if-exists=../../.env src/cli.ts reset-password",
    "user:list": "tsx --env-file-if-exists=../../.env src/cli.ts list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@cc/agent-runtime": "workspace:*",
    "@cc/brain": "workspace:*",
    "@cc/core": "workspace:*",
    "@cc/email": "workspace:*",
    "@cc/odoo": "workspace:*",
    "@cc/pa": "workspace:*",
    "@cc/social": "workspace:*",
    "@cc/storage": "workspace:*",
    "@cc/triage": "workspace:*",
    "@cc/verticals": "workspace:*",
    "@cc/video": "workspace:*",
    "@cc/voice": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "croner": "^10.0.1",
    "hono": "^4.13.13",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "sherpa-onnx-node": "1.13.8",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "playwright-core": "1.63.0",
    "smtp-server": "^3.21.1",
    "tsup": "^9.0.0"
  }
}
