# --- Required ---
# Postgres connection (Railway injects this when you add a Postgres service).
DATABASE_URL=postgres://cc:cc@localhost:5432/cc
# Admin token for first-run setup, API automation and MCP (you sign in to the app with email +
# password). Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Agent driver ---
# claude-code (default) or echo (no model, for trying the plumbing).
AGENT_RUNNER=claude-code
# Subscription auth for headless Claude Code. Create with `claude setup-token` on your PC.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: API key used only when the subscription hits a usage limit.
ANTHROPIC_FALLBACK_API_KEY=
AGENT_MAX_TURNS=30
AGENT_CONCURRENCY=2
# Runs per vertical at once (default 1), so one busy vertical can't starve the others.
AGENT_MAX_CONCURRENT_PER_VERTICAL=1
# Optional global cap on agent spend per day (USD). Over it, non-chat tasks are deferred.
# Per-vertical caps go in the manifest as dailyBudgetUsd.
AGENT_DAILY_BUDGET_USD=
# Identical prompts for the same vertical within this many minutes are linked, not re-run (0 = off).
AGENT_DEDUPE_WINDOW_MINUTES=10

# --- Digest ---
# Timezone that defines "today" for budgets and digests.
DAY_TIMEZONE=Europe/London
# When the daily digest is written (in DAY_TIMEZONE); "off" disables it.
DIGEST_CRON=30 18 * * *

# --- Triage ---
# Rules always run first. Each model triager joins the chain only when its key is set.
# TypeSafe Jev decision model (cheap, ~$0.04 per million input tokens).
JEV_API_KEY=
# Optional: defaults to https://api.typesafe.ai. For a LiteLLM proxy use http://<proxy>/typesafe.
JEV_BASE_URL=
# Optional: defaults to jev-latest; pin e.g. jev-1.13.0 for stable behaviour.
JEV_MODEL=
# Optional: Anthropic API key for the Claude Haiku fallback classifier.
ANTHROPIC_TRIAGE_API_KEY=
# The chain takes the first triager at or above this confidence.
TRIAGE_MIN_CONFIDENCE=0.7

# --- Brain ---
# Private git repo for the markdown brain, with a token that can push, e.g.
# https://x-access-token:<github-token>@github.com/desktopmachineshop/brain.git
BRAIN_REMOTE_URL=

# --- Odoo (optional) ---
# Set all four to give DMS and 3dpandme agents the odoo tools and Odoo actions.
# API key: Odoo → your avatar → My Preferences → Account Security → New API Key.
# e.g. ODOO_URL=https://yourcompany.odoo.com and ODOO_DB=yourcompany
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
# jsonrpc (default, Odoo 14+) or json2 (Odoo 19+).
ODOO_API=jsonrpc
# Odoo events (orders, customer messages, low stock, late deliveries, reviews), polled when Odoo is set.
# Blank/on = all sources with defaults; off; a list (orders,stock); or JSON, see docs/SETUP.md "Odoo events".
ODOO_EVENTS=

# --- Optional ---
# Token desktop worker nodes use (defaults to ADMIN_TOKEN).
WORKER_TOKEN=
# Shared secret for POST /api/ingress/webhook/:vertical (header x-cc-webhook-secret).
WEBHOOK_SECRET=
# Proxies in front of the server (Railway: 1). Used to find the client IP for sign-in rate limits; 0 = none.
TRUSTED_PROXY_HOPS=1
# Web push for approval notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dave@desktopmachineshop.com
SCHEDULES_ENABLED=true

# --- Email (optional; see docs/SETUP.md, "Email") ---
# JSON array of IMAP/SMTP accounts, on one line. Each: id, vertical, address, displayName?,
# imap {host, port, secure, user, pass}, smtp {host, port, secure, user, pass},
# mailbox? (default INBOX), ignoreFrom? (addresses or "@domain"), saveSent? (default true; false for Gmail).
# EMAIL_ACCOUNTS=[{"id":"shop","vertical":"dms","address":"support@desktopmachineshop.com","displayName":"Dave at Desktop Machine Shop","imap":{"host":"imap.gmail.com","port":993,"secure":true,"user":"support@desktopmachineshop.com","pass":"app-password"},"smtp":{"host":"smtp.gmail.com","port":465,"secure":true,"user":"support@desktopmachineshop.com","pass":"app-password"},"ignoreFrom":["@mailchimp.com"]}]
EMAIL_ACCOUNTS=
# How often each mailbox is re-checked. IDLE usually delivers new mail within seconds anyway.
EMAIL_POLL_INTERVAL_SECONDS=300

# --- Social (optional; see docs/SETUP.md, "Social") ---
# JSON array of social accounts, on one line. Each: id, platform (discord|instagram|threads|x|reddit),
# vertical, handle?, displayName?, inbound? (default true), credentials {...per platform}, options? {...}.
# SOCIAL_ACCOUNTS=[{"id":"3dp-instagram","platform":"instagram","vertical":"3dpandme","handle":"3dpandme","credentials":{"accessToken":"..."}}]
SOCIAL_ACCOUNTS=
# Poll interval for platforms whose adapter doesn't suggest one.
SOCIAL_POLL_DEFAULT_SECONDS=300
# This server's public URL. Uploaded media is served at <PUBLIC_BASE_URL>/media/<id>, which
# Instagram and Threads fetch when publishing, e.g. https://command.desktopmachineshop.com
PUBLIC_BASE_URL=
# Largest image or video POST /api/media accepts, in MB.
MEDIA_MAX_MB=200

# --- Voice / Drive mode (all optional; without keys the PWA uses browser speech) ---
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# VOICE_STT_PROVIDER=auto
# VOICE_TTS_PROVIDER=auto
# VOICE_ELEVENLABS_VOICE=

# --- Personal assistant (optional; see docs/SETUP.md, "Personal assistant") ---
# One Google OAuth client and refresh token, shared by Calendar and Drive storage.
# Get the refresh token once with: GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... pnpm --filter @cc/pa google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# JSON array of Google Calendar accounts, on one line. Each: id, provider ("google"), vertical,
# calendars? (default ["primary"]; ids or {id, name?, write?}), credentials? (defaults to the GOOGLE_* above).
# CALENDAR_ACCOUNTS=[{"id":"google","provider":"google","vertical":"personal","calendars":["primary",{"id":"family0123@group.calendar.google.com","name":"Family"}]}]
CALENDAR_ACCOUNTS=
